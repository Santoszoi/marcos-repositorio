{
  "name": "catalogo-flow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/build-site.mjs",
    "build:site": "npm run build",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "preview": "wrangler dev --ip 0.0.0.0 --port 3000",
    "build:next": "next build --webpack",
    "test:integration": "node scripts/run-integration.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@opennextjs/cloudflare": "1.20.9",
    "bcryptjs": "^3.0.2",
    "zod": "4.6.5",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "5.9.3",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "tsx": "^4.20.0",
    "drizzle-kit": "0.31.10",
    "wrangler": "4.148.0",
    "@cloudflare/workers-types": "5.20261006.1"
  }
}
